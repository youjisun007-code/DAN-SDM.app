ANTHROPIC_API_KEY=your-api-key-here
# 선택: 기본값은 claude-opus-5
# CLAUDE_MODEL=claude-opus-5

# 학생 접속용 공용 비밀번호 (설정하지 않으면 인증 없이 접속 가능)
STUDENT_PASSWORD=change-me

# Flask 세션 서명 키 (배포 시 무작위 값으로 변경 필수)
SECRET_KEY=change-me-too

# 학생 대화 기록을 저장할 Google 스프레드시트 웹훅 (선택, 설정 안 하면 로그 저장 안 함)
# scripts/google-sheets-webhook.gs 참고
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_TOKEN=
